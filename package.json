{
  "name": "@ambire/token-and-network-icons",
  "version": "1.0.0",
  "description": "Token and network icons bundled with the Ambire wallet apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmbireTech/token-and-network-icons.git"
  },
  "files": [
    "assets/tokenIcons",
    "assets/networkIcons",
    "index/tokenIconKeys.json",
    "index/networkIconChainIds.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "npm run generate:token-icons && npm run generate:network-icons",
    "generate:token-icons": "node scripts/generate-token-icons.js",
    "generate:network-icons": "node scripts/generate-network-icons.js"
  },
  "devDependencies": {
    "sharp": "0.35.5"
  }
}
